{
  "entities": {
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Profil privat akun pemain Business Tycoon Tap",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 320
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "PlayerSave": {
      "title": "PlayerSave",
      "description": "Cadangan cloud Save Schema v2 untuk progres pemain",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "version": {
          "type": "number"
        },
        "balance": {
          "type": "number"
        },
        "perClick": {
          "type": "number"
        },
        "perSecond": {
          "type": "number"
        },
        "totalTaps": {
          "type": "integer"
        },
        "totalEarned": {
          "type": "number"
        },
        "upgrades": {
          "type": "object",
          "properties": {
            "gloves": {
              "type": "integer"
            },
            "tap_machine": {
              "type": "integer"
            },
            "auto_team": {
              "type": "integer"
            }
          },
          "required": ["gloves", "tap_machine", "auto_team"]
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 20
        },
        "settings": {
          "type": "object",
          "properties": {
            "sound": {
              "type": "boolean"
            },
            "haptic": {
              "type": "boolean"
            }
          },
          "required": ["sound", "haptic"]
        },
        "startDate": {
          "type": "integer"
        },
        "clientSavedAt": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "version",
        "balance",
        "perClick",
        "perSecond",
        "totalTaps",
        "totalEarned",
        "upgrades",
        "milestones",
        "settings",
        "startDate",
        "clientSavedAt",
        "updatedAt"
      ]
    },
    "PortfolioHolding": {
      "title": "PortfolioHolding",
      "description": "Kepemilikan aset investasi portofolio pemain di Firestore",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "assetId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "units": {
          "type": "integer"
        },
        "avgEntry": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "assetId", "units", "avgEntry", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/private/{docId}": {
      "schema": {
        "$ref": "#/entities/UserPrivateProfile"
      },
      "description": "Profil privat pemain terisolasi per UID"
    },
    "/playerSaves/{userId}": {
      "schema": {
        "$ref": "#/entities/PlayerSave"
      },
      "description": "Dokumen cloud save milik pemain per UID"
    },
    "/playerSaves/{userId}/holdings/{assetId}": {
      "schema": {
        "$ref": "#/entities/PortfolioHolding"
      },
      "description": "Posisi kepemilikan portofolio per aset milik pemain per UID"
    }
  }
}
