rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny semua akses yang tidak diizinkan secara eksplisit
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAssetId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn() && request.auth.uid == userId && request.auth.token.email_verified == true;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 320
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUpgrades(upgrades) {
      return upgrades is map
        && upgrades.keys().hasAll(['gloves', 'tap_machine', 'auto_team'])
        && upgrades.keys().hasOnly(['gloves', 'tap_machine', 'auto_team'])
        && upgrades.gloves is int && upgrades.gloves >= 0
        && upgrades.tap_machine is int && upgrades.tap_machine >= 0
        && upgrades.auto_team is int && upgrades.auto_team >= 0;
    }

    function isValidSettings(settings) {
      return settings is map
        && settings.keys().hasAll(['sound', 'haptic'])
        && settings.keys().hasOnly(['sound', 'haptic'])
        && settings.sound is bool
        && settings.haptic is bool;
    }

    function isValidMilestones(milestones) {
      return milestones is list
        && milestones.size() <= 20
        && (milestones.size() == 0 || (milestones[0] is string && milestones[0].size() > 0 && milestones[0].size() <= 64));
    }

    function isValidPlayerSave(data, userId) {
      return data.keys().hasAll(['userId', 'version', 'balance', 'perClick', 'perSecond', 'totalTaps', 'totalEarned', 'upgrades', 'milestones', 'settings', 'startDate', 'clientSavedAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'version', 'balance', 'perClick', 'perSecond', 'totalTaps', 'totalEarned', 'upgrades', 'milestones', 'settings', 'startDate', 'clientSavedAt', 'updatedAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.version is number && data.version == 2
        && data.balance is number && data.balance >= 0
        && data.perClick is number && data.perClick >= 0
        && data.perSecond is number && data.perSecond >= 0
        && data.totalTaps is int && data.totalTaps >= 0
        && data.totalEarned is number && data.totalEarned >= 0
        && isValidUpgrades(data.upgrades)
        && isValidMilestones(data.milestones)
        && isValidSettings(data.settings)
        && data.startDate is int && data.startDate >= 0
        && data.clientSavedAt is int && data.clientSavedAt >= 0
        && data.updatedAt is timestamp;
    }

    function isValidPortfolioHolding(data, userId, assetId) {
      return data.keys().hasAll(['userId', 'assetId', 'units', 'avgEntry', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'assetId', 'units', 'avgEntry', 'updatedAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.assetId is string && data.assetId == assetId && isValidAssetId(data.assetId)
        && data.units is int && data.units >= 1
        && data.avgEntry is number && data.avgEntry >= 0
        && data.updatedAt is timestamp;
    }

    function hasOwnedParentSaveAfter(userId) {
      return existsAfter(/databases/$(database)/documents/playerSaves/$(userId))
        && getAfter(/databases/$(database)/documents/playerSaves/$(userId)).data.userId == request.auth.uid;
    }

    function hasOwnedParentSave(userId) {
      return exists(/databases/$(database)/documents/playerSaves/$(userId))
        && get(/databases/$(database)/documents/playerSaves/$(userId)).data.userId == request.auth.uid;
    }

    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && docId == 'profile'
        && isVerifiedOwner(userId)
        && isValidUserPrivate(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && docId == 'profile'
        && isVerifiedOwner(userId)
        && isValidUserPrivate(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if isValidId(userId) && docId == 'profile' && isVerifiedOwner(userId);
    }

    match /playerSaves/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidPlayerSave(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidPlayerSave(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'version',
          'balance',
          'perClick',
          'perSecond',
          'totalTaps',
          'totalEarned',
          'upgrades',
          'milestones',
          'settings',
          'startDate',
          'clientSavedAt',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isVerifiedOwner(userId);

      match /holdings/{assetId} {
        allow get: if isValidId(userId) && isValidAssetId(assetId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId) && isVerifiedOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidAssetId(assetId)
          && isVerifiedOwner(userId)
          && isValidPortfolioHolding(incoming(), userId, assetId)
          && incoming().updatedAt == request.time
          && hasOwnedParentSaveAfter(userId);
        allow update: if isValidId(userId) && isValidAssetId(assetId)
          && isVerifiedOwner(userId)
          && isValidPortfolioHolding(incoming(), userId, assetId)
          && incoming().userId == existing().userId
          && incoming().assetId == existing().assetId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['units', 'avgEntry', 'updatedAt'])
          && hasOwnedParentSave(userId);
        allow delete: if isValidId(userId) && isValidAssetId(assetId)
          && isVerifiedOwner(userId)
          && hasOwnedParentSave(userId);
      }
    }
  }
}
